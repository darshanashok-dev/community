# Application Configuration Template
# Copy this file to .env for local development and set values as needed.
# Never commit your actual .env file or API keys to version control.

# Flask runtime settings (keep FLASK_DEBUG=0 for normal/demonstration use)
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Secret key for Flask session signing (generate a strong random value for local runs)
SECRET_KEY=replace-with-a-local-random-secret-key

# Google Safe Browsing API v5 (used in Phase 3 after explicit user consent)
SAFE_BROWSING_API_KEY=

# Outbound external check settings (Phase 3)
EXTERNAL_API_TIMEOUT_SECONDS=5
RDAP_BASE_URL=https://rdap.org/domain/

# Input size limits
MAX_MESSAGE_LENGTH=5000
MAX_URL_LENGTH=2048
